/// Rachas de días seguidos sobre la guía de 24 h (gaps and islands sobre los días con dato). Un día con dato que cumple la guía corta la racha; los huecos sin dato de hasta 7 días no la cortan ni la alargan (se informan en dias_sin_dato) y uno más largo sí la corta.
table agg_rachas
	lineageTag: 26717cf8-1e36-5ad6-944a-fca4f73c0e20

	/// Estación.
	column id_estacion
		dataType: string
		isHidden
		lineageTag: c3bb7b62-1712-5bea-b6ad-8321dcb6ac4a
		summarizeBy: none
		sourceColumn: id_estacion

		annotation SummarizationSetBy = User

	/// Contaminante.
	column id_contaminante
		dataType: string
		isHidden
		lineageTag: 2399cf4e-291c-5a20-8d54-a6e15e925075
		summarizeBy: none
		sourceColumn: id_contaminante

		annotation SummarizationSetBy = User

	/// Primer día de la racha.
	column fecha_inicio
		dataType: dateTime
		formatString: Short Date
		lineageTag: ad4684b7-b635-5fec-8865-6f117ec47506
		summarizeBy: none
		sourceColumn: fecha_inicio

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Último día de la racha.
	column fecha_fin
		dataType: dateTime
		formatString: Short Date
		lineageTag: af7ecc84-a438-5ce4-accf-84c645b3674b
		summarizeBy: none
		sourceColumn: fecha_fin

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Días con dato sobre la guía en la racha.
	column dias
		dataType: int64
		formatString: 0
		lineageTag: 47a1d9b4-d77e-5b0e-a35f-0fd113109d1b
		summarizeBy: none
		sourceColumn: dias

		annotation SummarizationSetBy = User

	/// Días de calendario entre el primero y el último de la racha.
	column dias_calendario
		dataType: int64
		formatString: 0
		lineageTag: b13a3045-69db-5425-b416-83c1a6e703ff
		summarizeBy: none
		sourceColumn: dias_calendario

		annotation SummarizationSetBy = User

	/// Días sin dato dentro de la racha (dias_calendario − dias).
	column dias_sin_dato
		dataType: int64
		formatString: 0
		lineageTag: 88526af2-75d7-5431-a987-636f60dc71a3
		summarizeBy: none
		sourceColumn: dias_sin_dato

		annotation SummarizationSetBy = User

	/// Verdadero si es la racha más larga de su estación × contaminante.
	column es_racha_maxima
		dataType: boolean
		lineageTag: 8de14e08-953a-5e78-bfa2-f4f2821d4d9c
		summarizeBy: none
		sourceColumn: es_racha_maxima

		annotation SummarizationSetBy = User

	partition agg_rachas = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "agg_rachas.parquet"))
				in
				    Origen

	annotation PBI_ResultType = Table

