/// Matriz de escalones: % de días que cumplen la guía OMS de 24 h y cada objetivo intermedio, por estación × contaminante × período × nivel. Acumulativo (quien cumple la guía cumple todos los IT).
table agg_cumplimiento_niveles
	lineageTag: 64d6d96f-4655-50cf-85e5-7a8b62744a14

	/// Estación.
	column id_estacion
		dataType: string
		isHidden
		lineageTag: 2b559df3-c4c6-5ffc-893e-c0daff5619b8
		summarizeBy: none
		sourceColumn: id_estacion

		annotation SummarizationSetBy = User

	/// Contaminante (NO2, PM10, CO).
	column id_contaminante
		dataType: string
		isHidden
		lineageTag: ef551fa4-8cb5-5b42-a5f1-4e0dd78e25f4
		summarizeBy: none
		sourceColumn: id_contaminante

		annotation SummarizationSetBy = User

	/// Período (clave hacia dim_periodo).
	column id_periodo
		dataType: string
		isHidden
		lineageTag: 598c0864-16dd-5ace-8be1-3aeb76e14b7e
		summarizeBy: none
		sourceColumn: id_periodo

		annotation SummarizationSetBy = User

	/// AQG, IT4, IT3, IT2 o IT1.
	column nivel
		dataType: string
		lineageTag: a8b8739c-edf8-5253-a003-d0cef853eecb
		summarizeBy: none
		sourceColumn: nivel
		sortByColumn: orden_exigencia

		annotation SummarizationSetBy = User

	/// Etiqueta legible del nivel.
	column nivel_etiqueta
		dataType: string
		lineageTag: 9f1d902a-6e70-59f9-9828-6aa99b2f5e90
		summarizeBy: none
		sourceColumn: nivel_etiqueta
		sortByColumn: orden_exigencia

		annotation SummarizationSetBy = User

	/// 1 = guía (más exigente) … 5 = IT1 (menos exigente). Para ordenar columnas.
	column orden_exigencia
		dataType: int64
		formatString: 0
		lineageTag: 14e17bf6-bebd-5be1-86c0-e3a67f229405
		summarizeBy: none
		sourceColumn: orden_exigencia

		annotation SummarizationSetBy = User

	/// Umbral de 24 h del nivel.
	column umbral
		dataType: double
		lineageTag: 84de9bd2-14b7-5880-9f01-f5de84a08963
		summarizeBy: none
		sourceColumn: umbral

		annotation SummarizationSetBy = User

	/// Unidad del umbral.
	column unidad
		dataType: string
		lineageTag: 2efcdd85-b8d8-53b6-af1f-570525956607
		summarizeBy: none
		sourceColumn: unidad

		annotation SummarizationSetBy = User

	/// Días con dato válido en el período.
	column n_dias_con_dato
		dataType: int64
		formatString: 0
		lineageTag: c2618739-e281-5009-a3e9-20c973810a19
		summarizeBy: none
		sourceColumn: n_dias_con_dato

		annotation SummarizationSetBy = User

	/// Días cuyo promedio de 24 h no supera el umbral.
	column n_dias_cumple
		dataType: int64
		formatString: 0
		lineageTag: 61d45bc3-dfce-5c1b-b693-a3a3f98403d8
		summarizeBy: none
		sourceColumn: n_dias_cumple

		annotation SummarizationSetBy = User

	/// Completitud del período (de agg_completitud_anual).
	column completitud
		dataType: double
		formatString: 0.0%
		lineageTag: 3ce1de47-a026-55e7-b0db-9046ec5c3b0b
		summarizeBy: none
		sourceColumn: completitud

		annotation SummarizationSetBy = User

	/// Verdadero si el período tiene >= 75% de días con dato.
	column es_valido
		dataType: boolean
		lineageTag: 4339d2ba-159e-50d5-9b38-e57f61fb6715
		summarizeBy: none
		sourceColumn: es_valido

		annotation SummarizationSetBy = User

	/// Verdadero si todos los trimestres tienen >= 75% (advertencia, no excluye).
	column cumple_criterio_trimestral
		dataType: boolean
		lineageTag: 513cc90e-4ed1-53e2-934f-f6d56b5fab20
		summarizeBy: none
		sourceColumn: cumple_criterio_trimestral

		annotation SummarizationSetBy = User

	/// n_dias_cumple / n_dias_con_dato (0 a 1). Vacío si el período no es válido.
	column pct_dias_cumple
		dataType: double
		formatString: 0.0%
		lineageTag: 1b2adfb0-b032-56e2-a971-134507c008fb
		summarizeBy: none
		sourceColumn: pct_dias_cumple

		annotation SummarizationSetBy = User

	/// El mismo cociente aunque el período no sea válido (solo para transparencia).
	column pct_referencial
		dataType: double
		formatString: 0.0%
		lineageTag: db14fcd4-9b9f-5bad-9e7c-f4095346e32b
		summarizeBy: none
		sourceColumn: pct_referencial

		annotation SummarizationSetBy = User

	partition agg_cumplimiento_niveles = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "agg_cumplimiento_niveles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"id_estacion", type text}, {"id_contaminante", type text}, {"id_periodo", type text}, {"nivel", type text}, {"nivel_etiqueta", type text}, {"orden_exigencia", Int64.Type}, {"umbral", type number}, {"unidad", type text}, {"n_dias_con_dato", Int64.Type}, {"n_dias_cumple", Int64.Type}, {"completitud", type number}, {"es_valido", type logical}, {"cumple_criterio_trimestral", type logical}, {"pct_dias_cumple", type number}, {"pct_referencial", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

