/// Indicadores anuales por estación × contaminante × período: años 2010 a 2026 (2026 parcial) y últimos 12 meses. Los del estudio (2024, 2025, 2026 y últimos 12 meses) tienen es_periodo_estudio = verdadero; 2010-2023 son contexto. Regla del 75%: si el período tiene menos de 75% de días con dato, los indicadores quedan vacíos (solo promedio_referencial).
table agg_anual
	lineageTag: e0a91c0f-ccea-5ca8-9d8a-6fe7fea89bc0

	/// Estación.
	column id_estacion
		dataType: string
		isHidden
		lineageTag: 877f5537-5c4c-5706-9cd6-55f7e7e3bf46
		summarizeBy: none
		sourceColumn: id_estacion

		annotation SummarizationSetBy = User

	/// Contaminante.
	column id_contaminante
		dataType: string
		isHidden
		lineageTag: b7bb35a2-520f-542c-8e76-c34dcc619dfd
		summarizeBy: none
		sourceColumn: id_contaminante

		annotation SummarizationSetBy = User

	/// Código del período: el año ('2024') o 'movil_12m'.
	column id_periodo
		dataType: string
		isHidden
		lineageTag: 2a8083c3-387b-596c-9787-e6639d425868
		summarizeBy: none
		sourceColumn: id_periodo

		annotation SummarizationSetBy = User

	/// Etiqueta legible del período.
	column periodo
		dataType: string
		lineageTag: 312430fd-a3d4-574f-b871-fcc27a8b2b48
		summarizeBy: none
		sourceColumn: periodo
		sortByColumn: orden_periodo

		annotation SummarizationSetBy = User

	/// anio_completo, anio_parcial o movil_12m.
	column tipo_periodo
		dataType: string
		lineageTag: 2f56f797-df7c-5062-ba65-73ed30f5761c
		summarizeBy: none
		sourceColumn: tipo_periodo

		annotation SummarizationSetBy = User

	/// Año (vacío para los últimos 12 meses).
	column anio
		dataType: int64
		formatString: 0
		lineageTag: 1a6bf79f-86eb-57db-bec9-da7d72e5c85d
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = User

	/// Para ordenar los períodos (los últimos 12 meses van al final).
	column orden_periodo
		dataType: int64
		formatString: 0
		lineageTag: 405dcaf7-bc40-549b-a734-a3a8b4d37507
		summarizeBy: none
		sourceColumn: orden_periodo

		annotation SummarizationSetBy = User

	/// Verdadero para 2024, 2025, 2026 y los últimos 12 meses; falso para el contexto 2010-2023.
	column es_periodo_estudio
		dataType: boolean
		lineageTag: 10496b3f-622a-540c-8f57-5727e1a04bde
		summarizeBy: none
		sourceColumn: es_periodo_estudio

		annotation SummarizationSetBy = User

	/// Días del período.
	column n_dias_periodo
		dataType: int64
		formatString: 0
		lineageTag: d1564a93-447c-5d99-b59a-6e305eb98a16
		summarizeBy: none
		sourceColumn: n_dias_periodo

		annotation SummarizationSetBy = User

	/// Días con promedio de 24 h válido.
	column n_dias_con_dato
		dataType: int64
		formatString: 0
		lineageTag: 6e40ccdd-643f-5e41-b6de-6f6a0e2b71bd
		summarizeBy: none
		sourceColumn: n_dias_con_dato

		annotation SummarizationSetBy = User

	/// n_dias_con_dato / n_dias_periodo (0 a 1).
	column completitud
		dataType: double
		formatString: 0.0%
		lineageTag: 2e76efa5-ab43-53ec-85da-98e99501dc06
		summarizeBy: none
		sourceColumn: completitud

		annotation SummarizationSetBy = User

	/// Verdadero si el período tiene >= 75% de días con dato.
	column es_valido
		dataType: boolean
		lineageTag: 9b2d61d9-2b97-5009-a169-6e13dc25b43d
		summarizeBy: none
		sourceColumn: es_valido

		annotation SummarizationSetBy = User

	/// Promedio de los valores diarios. Vacío si el período no es válido.
	column promedio_anual
		dataType: double
		lineageTag: 8a3a4247-14b5-5bd3-9323-99b77d113e14
		summarizeBy: none
		sourceColumn: promedio_anual

		annotation SummarizationSetBy = User

	/// El mismo promedio aunque el período no sea válido (solo para transparencia).
	column promedio_referencial
		dataType: double
		lineageTag: cb31036d-b953-55d7-869b-fcf095fab525
		summarizeBy: none
		sourceColumn: promedio_referencial

		annotation SummarizationSetBy = User

	/// Guía anual de la OMS (vacía para el CO).
	column guia_anual
		dataType: double
		lineageTag: ded4d1a0-547c-5f78-a66f-cfb6f5e09ca3
		summarizeBy: none
		sourceColumn: guia_anual

		annotation SummarizationSetBy = User

	/// promedio_anual / guia_anual.
	column veces_guia_anual
		dataType: double
		lineageTag: 785cfbcf-049d-5d26-9217-9adb1f489646
		summarizeBy: none
		sourceColumn: veces_guia_anual

		annotation SummarizationSetBy = User

	/// Escalón OMS del promedio anual (AQG, IT4 … IT1, '> IT1').
	column nivel_oms
		dataType: string
		lineageTag: bf78f3e1-4c52-589b-94ba-2ffcc8deba87
		summarizeBy: none
		sourceColumn: nivel_oms
		sortByColumn: orden_nivel_oms

		annotation SummarizationSetBy = User

	/// 1 = cumple la guía … 6 = no cumple ni el IT1 (para ordenar).
	column orden_nivel_oms
		dataType: int64
		formatString: 0
		lineageTag: 8d6581ed-edcf-5f96-a079-546c4809b677
		summarizeBy: none
		sourceColumn: orden_nivel_oms

		annotation SummarizationSetBy = User

	/// Próximo escalón a alcanzar.
	column proximo_nivel
		dataType: string
		lineageTag: 3bde0d80-74ac-5b0d-8bec-d2238abb8085
		summarizeBy: none
		sourceColumn: proximo_nivel

		annotation SummarizationSetBy = User

	/// Cuánto tendría que bajar el promedio para subir un escalón.
	column ug_para_proximo_nivel
		dataType: double
		lineageTag: eab3cf37-00f7-538d-ada6-8de199b2699d
		summarizeBy: none
		sourceColumn: ug_para_proximo_nivel

		annotation SummarizationSetBy = User

	/// Percentil 99 de los valores diarios (definición formal de la guía de 24 h). Vacío si no es válido.
	column p99_24h
		dataType: double
		lineageTag: 2f1dc1a3-a1af-5288-8d8a-2b05db6ee9c0
		summarizeBy: none
		sourceColumn: p99_24h

		annotation SummarizationSetBy = User

	/// p99_24h / guía OMS de 24 h (más de 1 = no se cumple la guía en sentido formal).
	column p99_veces_guia_24h
		dataType: double
		lineageTag: 5e9ca89b-4a86-5304-ac2f-f72b7b218dc4
		summarizeBy: none
		sourceColumn: p99_veces_guia_24h

		annotation SummarizationSetBy = User

	/// n_dias_supera_24h / n_dias_con_dato (0 a 1).
	column pct_dias_supera_24h
		dataType: double
		formatString: 0.0%
		lineageTag: 614c1ba3-59f6-5324-9f0d-41d680dadf7b
		summarizeBy: none
		sourceColumn: pct_dias_supera_24h

		annotation SummarizationSetBy = User

	/// % de días que cumplen la guía de 24 h (0 a 1). Vacío si el período no es válido.
	column pct_cumple_guia_24h
		dataType: double
		formatString: 0.0%
		lineageTag: dc45e490-903b-5ffb-867a-649e7486639d
		summarizeBy: none
		sourceColumn: pct_cumple_guia_24h

		annotation SummarizationSetBy = User

	/// % de días que cumplen el IT4 de 24 h o algo más exigente. Vacío si el nivel no existe.
	column pct_cumple_it4_24h
		dataType: double
		formatString: 0.0%
		lineageTag: 773e2b38-8333-5eb5-966b-e383f01eca9b
		summarizeBy: none
		sourceColumn: pct_cumple_it4_24h

		annotation SummarizationSetBy = User

