	partition agg_anual = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "agg_anual.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"id_estacion", type text}, {"id_contaminante", type text}, {"id_periodo", type text}, {"periodo", type text}, {"tipo_periodo", type text}, {"anio", Int64.Type}, {"orden_periodo", Int64.Type}, {"es_periodo_estudio", type logical}, {"n_dias_periodo", Int64.Type}, {"n_dias_con_dato", Int64.Type}, {"completitud", type number}, {"es_valido", type logical}, {"promedio_anual", type number}, {"promedio_referencial", type number}, {"guia_anual", type number}, {"veces_guia_anual", type number}, {"nivel_oms", type text}, {"orden_nivel_oms", Int64.Type}, {"proximo_nivel", type text}, {"ug_para_proximo_nivel", type number}, {"p99_24h", type number}, {"p99_veces_guia_24h", type number}, {"pct_dias_supera_24h", type number}, {"pct_cumple_guia_24h", type number}, {"pct_cumple_it4_24h", type number}, {"pct_cumple_it3_24h", type number}, {"pct_cumple_it2_24h", type number}, {"pct_cumple_it1_24h", type number}, {"racha_maxima_dias", Int64.Type}, {"racha_desde", type date}, {"racha_hasta", type date}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

