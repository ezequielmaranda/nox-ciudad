/// Guías OMS 2021 en formato ancho (una fila por contaminante × promedio). Se usa vía JOIN.
table ref_oms
	lineageTag: f78cbef2-6171-5f87-a435-da9e6d63c2fb

	/// Clave del contaminante.
	column id_contaminante
		dataType: string
		isHidden
		lineageTag: faa77ced-7061-5a39-82e0-04e8e9de963f
		summarizeBy: none
		sourceColumn: id_contaminante

		annotation SummarizationSetBy = User

	/// Nombre corto.
	column contaminante
		dataType: string
		lineageTag: 9b44920d-d040-58e2-ae09-865519c3ffee
		summarizeBy: none
		sourceColumn: contaminante

		annotation SummarizationSetBy = User

	/// '24h' o 'anual'.
	column promedio
		dataType: string
		lineageTag: 6247f49a-5853-5ea5-a947-71957fff40f0
		summarizeBy: none
		sourceColumn: promedio

		annotation SummarizationSetBy = User

	/// Nivel guía (AQG).
	column guia_oms
		dataType: double
		lineageTag: c3185257-c9d6-5612-b392-b22ee5ff953f
		summarizeBy: none
		sourceColumn: guia_oms

		annotation SummarizationSetBy = User

	/// Objetivo intermedio 1 (el menos exigente).
	column it1
		dataType: double
		lineageTag: eb0d1b92-dcc4-5ba8-8f3d-62effba86750
		summarizeBy: none
		sourceColumn: it1

		annotation SummarizationSetBy = User

	/// Objetivo intermedio 2.
	column it2
		dataType: double
		lineageTag: 02480dfe-30c9-5eca-a566-4c0f26681ac1
		summarizeBy: none
		sourceColumn: it2

		annotation SummarizationSetBy = User

	/// Objetivo intermedio 3.
	column it3
		dataType: double
		lineageTag: 4927879a-ce6b-58dd-9fc6-d390b756a684
		summarizeBy: none
		sourceColumn: it3

		annotation SummarizationSetBy = User

	/// Objetivo intermedio 4.
	column it4
		dataType: double
		lineageTag: b2f7ebe9-e7f4-5688-89c6-0bbaa417858e
		summarizeBy: none
		sourceColumn: it4

		annotation SummarizationSetBy = User

	/// Unidad de la guía.
	column unidad
		dataType: string
		lineageTag: cecd3de9-762f-5ea6-a754-2017341171c0
		summarizeBy: none
		sourceColumn: unidad

		annotation SummarizationSetBy = User

	partition ref_oms = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "ref_oms.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"id_contaminante", type text}, {"contaminante", type text}, {"promedio", type text}, {"guia_oms", type number}, {"it1", type number}, {"it2", type number}, {"it3", type number}, {"it4", type number}, {"unidad", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

