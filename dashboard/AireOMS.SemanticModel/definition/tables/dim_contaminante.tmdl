/// Una fila por contaminante, con unidades y factor de conversión a masa.
table dim_contaminante
	lineageTag: b9207842-29c4-54f2-a810-847618ebf5a4

	/// Clave del contaminante ('no2', 'pm10', 'co').
	column id_contaminante
		dataType: string
		isHidden
		lineageTag: cb976804-00e5-5531-b633-4370276e3814
		summarizeBy: none
		sourceColumn: id_contaminante

		annotation SummarizationSetBy = User

	/// Nombre como figura en la fuente ('NO2', 'PM10').
	column codigo_fuente
		dataType: string
		lineageTag: 11d685c0-2350-5893-a852-b1cc80f15aae
		summarizeBy: none
		sourceColumn: codigo_fuente
		sortByColumn: orden

		annotation SummarizationSetBy = User

	/// Nombre completo.
	column nombre
		dataType: string
		lineageTag: 419a4533-4dad-59e6-a8fe-97f71d5cfaed
		summarizeBy: none
		sourceColumn: nombre
		sortByColumn: orden

		annotation SummarizationSetBy = User

	/// Unidad en que se mide y publica (ppb, ppm o µg/m³).
	column unidad_medicion
		dataType: string
		lineageTag: f9483ee5-bca2-5190-a3cd-d6fb4a177b05
		summarizeBy: none
		sourceColumn: unidad_medicion

		annotation SummarizationSetBy = User

	/// Unidad de la guía OMS (µg/m³ o mg/m³).
	column unidad_masa
		dataType: string
		lineageTag: f9f6443d-12a9-55f1-8e7b-339a8d4f2d69
		summarizeBy: none
		sourceColumn: unidad_masa

		annotation SummarizationSetBy = User

	/// Peso molecular en g/mol (vacío para PM10).
	column peso_molecular
		dataType: double
		lineageTag: 53d0e604-ce23-5c40-b47d-84c6e8fbfa33
		summarizeBy: none
		sourceColumn: peso_molecular

		annotation SummarizationSetBy = User

	/// Multiplicador de unidad_medicion a unidad_masa: peso_molecular / 24,45 (25 °C, 1 atm).
	column factor_masa
		dataType: double
		lineageTag: 1a681ffb-6bc1-53ee-ad0e-15bb41b24c3f
		summarizeBy: none
		sourceColumn: factor_masa

		annotation SummarizationSetBy = User

	/// Cómo publica la red el contaminante: 'horario' (NO2), 'movil_8h' (CO) o 'movil_24h' (PM10).
	column promedio_fuente
		dataType: string
		lineageTag: db62270b-21b6-594d-a157-4cdef5c5fa02
		summarizeBy: none
		sourceColumn: promedio_fuente

		annotation SummarizationSetBy = User

	/// Horas que abarca cada valor publicado (1, 8 o 24).
	column horas_promedio_fuente
		dataType: int64
		formatString: 0
		lineageTag: f42ebb8b-fff4-5f8f-9ebf-6b6d909f1f71
		summarizeBy: none
		sourceColumn: horas_promedio_fuente

		annotation SummarizationSetBy = User

	/// Máximo plausible para un valor horario en la Ciudad (regla fuera_de_rango).
	column maximo_plausible
		dataType: double
		lineageTag: 74e396b3-c04a-5be3-a22e-95302f581d5c
		summarizeBy: none
		sourceColumn: maximo_plausible

		annotation SummarizationSetBy = User

	/// Verdadero si la OMS tiene guía de 24 h para el contaminante.
	column tiene_guia_24h
		dataType: boolean
		lineageTag: 74a6829a-66a1-5a20-97ee-e646f4c01b71
		summarizeBy: none
		sourceColumn: tiene_guia_24h

		annotation SummarizationSetBy = User

	/// Verdadero si la OMS tiene guía anual para el contaminante.
	column tiene_guia_anual
		dataType: boolean
		lineageTag: 53f48fd1-ffef-56cb-ab9f-bbd42322bc06
		summarizeBy: none
		sourceColumn: tiene_guia_anual

		annotation SummarizationSetBy = User

	/// Orden para gráficos (NO2 primero).
	column orden
		dataType: int64
		formatString: 0
		lineageTag: d9895d24-4ab1-55fb-a4f0-55380752b5d5
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = User

	/// Qué es, de dónde sale y por qué importa.
	column descripcion
		dataType: string
		lineageTag: 4ea5ec66-0348-5765-9670-bee432f9f359
		summarizeBy: none
		sourceColumn: descripcion

		annotation SummarizationSetBy = User

	partition dim_contaminante = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_contaminante.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"id_contaminante", type text}, {"codigo_fuente", type text}, {"nombre", type text}, {"unidad_medicion", type text}, {"unidad_masa", type text}, {"peso_molecular", type number}, {"factor_masa", type number}, {"promedio_fuente", type text}, {"horas_promedio_fuente", Int64.Type}, {"maximo_plausible", type number}, {"tiene_guia_24h", type logical}, {"tiene_guia_anual", type logical}, {"orden", Int64.Type}, {"descripcion", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

