/// Guías OMS en formato largo (UNPIVOT de ref_oms), una fila por nivel. Para líneas de referencia.
table ref_oms_niveles
	lineageTag: 059f8f8c-3adf-5527-9b8e-2aeb1afb362f

	/// Clave del contaminante.
	column id_contaminante
		dataType: string
		isHidden
		lineageTag: 777d876f-a17a-55ac-93bd-436920bc562f
		summarizeBy: none
		sourceColumn: id_contaminante

		annotation SummarizationSetBy = User

	/// Nombre corto.
	column contaminante
		dataType: string
		lineageTag: 605e1132-5f99-5847-b7ef-a4a9d52d12a0
		summarizeBy: none
		sourceColumn: contaminante

		annotation SummarizationSetBy = User

	/// '24h' o 'anual'.
	column promedio
		dataType: string
		lineageTag: b10a48dc-8381-57b1-be69-673bb8f177db
		summarizeBy: none
		sourceColumn: promedio

		annotation SummarizationSetBy = User

	/// AQG, IT4, IT3, IT2 o IT1.
	column nivel
		dataType: string
		lineageTag: c747e69f-428b-507b-baf9-cf4c6c370723
		summarizeBy: none
		sourceColumn: nivel
		sortByColumn: orden_exigencia

		annotation SummarizationSetBy = User

	/// Etiqueta legible del nivel.
	column nivel_etiqueta
		dataType: string
		lineageTag: 22b72994-c7e8-539f-8172-549873e5585f
		summarizeBy: none
		sourceColumn: nivel_etiqueta
		sortByColumn: orden_exigencia

		annotation SummarizationSetBy = User

	/// 1 = más exigente (guía) … 5 = menos exigente (IT1).
	column orden_exigencia
		dataType: int64
		formatString: 0
		lineageTag: 33e76fea-eecc-5aa6-9a8f-744773191750
		summarizeBy: none
		sourceColumn: orden_exigencia

		annotation SummarizationSetBy = User

	/// Valor del umbral.
	column umbral
		dataType: double
		lineageTag: 293c50dd-a402-5b41-b7de-ba589aa32ddb
		summarizeBy: none
		sourceColumn: umbral

		annotation SummarizationSetBy = User

	/// Unidad del umbral.
	column unidad
		dataType: string
		lineageTag: 1af282da-3fdd-5bec-91d3-2b391935dbfa
		summarizeBy: none
		sourceColumn: unidad

		annotation SummarizationSetBy = User

	partition ref_oms_niveles = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "ref_oms_niveles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"id_contaminante", type text}, {"contaminante", type text}, {"promedio", type text}, {"nivel", type text}, {"nivel_etiqueta", type text}, {"orden_exigencia", Int64.Type}, {"umbral", type number}, {"unidad", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

