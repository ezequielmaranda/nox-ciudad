/// Estado de cada PDF de la extracción (279 procesados y 2 descartados por estar enlazados en la estación equivocada).
table calidad_archivos
	lineageTag: 0e074370-848b-5d15-820b-2fb945b150f5

	/// Estación cuya página enlaza el archivo.
	column id_estacion
		dataType: string
		isHidden
		lineageTag: 206a3e9f-2952-5e5d-a82d-77005dc19eb0
		summarizeBy: none
		sourceColumn: id_estacion

		annotation SummarizationSetBy = User

	/// co, nox o pm10.
	column tipo_informe
		dataType: string
		lineageTag: dadc1bf5-61a3-5e24-be03-1ef4d0f03bbe
		summarizeBy: none
		sourceColumn: tipo_informe

		annotation SummarizationSetBy = User

	/// Año del informe.
	column anio
		dataType: int64
		formatString: 0
		lineageTag: 884206dc-9830-5558-9ade-39e3828842df
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = User

	/// Mes del informe.
	column mes
		dataType: int64
		formatString: 0
		lineageTag: de35232c-3827-51c5-8e57-22781a07f410
		summarizeBy: none
		sourceColumn: mes

		annotation SummarizationSetBy = User

	/// Nombre del PDF.
	column archivo
		dataType: string
		lineageTag: 4a0d33e6-b610-53b8-b898-92b7303eb86c
		summarizeBy: none
		sourceColumn: archivo

		annotation SummarizationSetBy = User

	/// ok, ok_con_aviso, descartado o error.
	column estado
		dataType: string
		lineageTag: a243deb9-b608-5dee-80ef-1abe18372a97
		summarizeBy: none
		sourceColumn: estado

		annotation SummarizationSetBy = User

	/// Detalle del estado o del aviso.
	column estado_detalle
		dataType: string
		lineageTag: 936d3a68-a7e4-5210-8182-9edb1fc38bb5
		summarizeBy: none
		sourceColumn: estado_detalle

		annotation SummarizationSetBy = User

	/// Estación que dice el encabezado del PDF.
	column estacion_en_encabezado
		dataType: string
		lineageTag: b1da1655-e3ba-5470-88d9-f0bf7b08b51e
		summarizeBy: none
		sourceColumn: estacion_en_encabezado

		annotation SummarizationSetBy = User

	partition calidad_archivos = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "calidad_archivos.parquet"))
				in
				    Origen

	annotation PBI_ResultType = Table

